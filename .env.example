# Local configuration. Copy values from your connected services; never commit secrets.
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=
APP_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
# Server-only PostHog Query Read credential and project configuration.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=
GEMINI_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Existing AZUNA_API_ID and AZUNA_API_KEY names are accepted as Adzuna fallbacks.

# Company research: the Next.js app needs these two Trigger.dev settings.
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
# Worker only: configure these in Trigger.dev, or locally for trigger:dev.
INSFORGE_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Also give the worker NEXT_PUBLIC_INSFORGE_URL and GEMINI_API_KEY above.
# Optional worker analytics use the existing PostHog settings above.
